{
  "name": "slamy",
  "version": "2.1.0",
  "private": true,
  "description": "Slack CLI tool and library for TypeScript",
  "type": "module",
  "engines": {
    "node": ">=25"
  },
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "bin": {
    "slack-api-cli": "dist/cli/index.js",
    "slamy": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:consumer": "node scripts/test-package-consumer.mjs",
    "ci:cost-check": "node scripts/check-actions-cost-guard.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "lint": "npm run lint:md",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#dist\" \"#go-src\""
  },
  "dependencies": {
    "@slack/bolt": "^5.1.0",
    "@slack/web-api": "^8.3.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^4.1.11",
    "markdownlint-cli2": "^0.24.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8"
  },
  "files": [
    "dist"
  ]
}
